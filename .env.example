# Production: set these in Render Environment Variables, not in Git.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=Codecrasher
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash

# Development only. Never enable this in production.
# DEMO_MODE=true
# PORT=3000
